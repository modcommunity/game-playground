[physics]

common/physics_ticks_per_second=128

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[editor_plugins]

enabled=PackedStringArray("res://addons/dot_server/plugin.cfg", "res://addons/dot_fps_controller/plugin.cfg", "res://addons/dot_timer/plugin.cfg", "res://addons/dot_map/plugin.cfg", "res://addons/dot_props/plugin.cfg", "res://addons/dot_leaderboard/plugin.cfg")
